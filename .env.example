# ==========================================
# RiikonCenter Environment Variables (Root)
# ==========================================

# -----------------
# PostgreSQL (Database)
# -----------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=riikoncenter

# -----------------
# API Service (apps/api)
# -----------------
PORT=3309
# For Docker Compose, DATABASE_URL automatically resolves to postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public
# For local development outside Docker, use localhost:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/riikoncenter?schema=public"

# When using Docker Compose, REDIS_URL will default to redis://redis:6379 inside the Docker network.
# For local development outside Docker, use redis://localhost:6379:
REDIS_URL="redis://redis:6379"
JWT_SECRET="super-secret-key-change-me"
PAT_GITHUB=""

# -----------------
# Web Frontend (apps/web)
# -----------------
NEXT_PUBLIC_API_URL="http://localhost/api"

# -----------------
# External Submodules
# -----------------
KONNNS_TOOL_PORT=3001
